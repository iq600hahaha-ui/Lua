-- สร้าง Window หลัก (ภาษาไทย / ไม่มี Key)
local Window = Rayfield:CreateWindow({
    Name = "MM2 Ultimate Script | ภาษาไทย",
    LoadingTitle = "กำลังโหลดระบบ MM2...",
